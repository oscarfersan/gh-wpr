#!/usr/bin/env bash
# Entry point for `gh wpr`. Node runs the TypeScript sources directly (type stripping),
# so there is no build step. Set GH_WPR_NODE to pick a specific node binary.
set -euo pipefail

source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
	dir="$(cd -P "$(dirname "$source_path")" && pwd)"
	source_path="$(readlink "$source_path")"
	[[ "$source_path" != /* ]] && source_path="$dir/$source_path"
done
root="$(cd -P "$(dirname "$source_path")" && pwd)"

node_bin="${GH_WPR_NODE:-node}"
if ! command -v "$node_bin" >/dev/null 2>&1; then
	echo "gh wpr needs Node.js 22.18 or newer. Install it, or set GH_WPR_NODE to its path." >&2
	exit 1
fi

exec "$node_bin" --disable-warning=ExperimentalWarning "$root/src/cli.ts" "$@"
