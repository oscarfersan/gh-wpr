{
	"repos": ["your-org/your-repo"],
	"team": ["your-login", "teammate-login"],
	"ignoreChecks": ["Some flaky workflow"],
	"localPaths": {
		"your-org/your-repo": "~/code/your-repo"
	},
	"notify": true,
	"claude": {
		"command": "claude",
		"prompt": "Triage the open review comments on {url}"
	},
	"fullRefreshMinutes": 10,
	"coderabbit": {
		"enabled": true,
		"login": "coderabbitai",
		"checkName": "CodeRabbit",
		"unstickCommand": "@coderabbitai full review",
		"noStartAfterMinutes": 10,
		"stuckAfterMinutes": 30,
		"rateLimitFallbackMinutes": 10
	},
	"codex": {
		"enabled": true,
		"login": "chatgpt-codex-connector",
		"command": "@codex review",
		"timeoutMinutes": 15
	},
	"notion": {
		"enabled": true,
		"marker": "Notion AI review"
	},
	"nudge": {
		"mode": "comment",
		"comment": "{mentions} review"
	},
	"labels": {
		"needsReview": "needs-review",
		"needsAuthor": "needs-author-action",
		"approved": "approved"
	},
	"finish": {
		"mergeMethod": "merge",
		"deleteBranch": true,
		"waitForCi": true,
		"requireBots": false
	},
	"tracker": {
		"kind": "none",
		"dataSourceId": "",
		"prProperty": "PR",
		"statusProperty": "Status",
		"commitProperty": "Merge commit",
		"statusByBase": {}
	}
}
